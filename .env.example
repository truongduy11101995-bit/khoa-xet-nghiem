# =========================================================================
# BỆNH VIỆN ĐA KHOA THIÊN ÂN - VIỄN ĐÔNG | KHOA XÉT NGHIỆM
# CẤU HÌNH BIẾN MÔI TRƯỜNG CLOUD (SUPABASE + VERCEL / RENDER)
# =========================================================================

# 1. KẾT NỐI DATABASE SUPABASE (POSTGRESQL MIỄN PHÍ)
# Lấy chuỗi này từ Supabase Dashboard: Project Settings -> Database -> Connection String (URI / Pooler)
# Chế độ Transaction Pooler (Cổng 6543 - Tối ưu cho Vercel Serverless):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# (Tùy chọn) API Supabase Storage nếu lưu trữ tài liệu lên Cloud
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. KHÓA BẢO VỆ CHỈ CHO PHÉP WI-FI CƠ QUAN (IP WHITELAYER)
# Nhập các địa chỉ IP Public của mạng Wi-Fi cơ quan (cách nhau bởi dấu phẩy)
# Ví dụ: nếu viện có 2 đường truyền Internet (VNPT & Viettel)
# Hỗ trợ: IP đơn lẻ (113.161.45.12), dải wildcard (172.16.12.*), hoặc CIDR (113.161.45.0/24)
# Nếu để trống hoặc đặt "*", hệ thống sẽ cho phép mọi IP (dùng khi mới chạy thử nghiệm)
ALLOWED_OFFICE_IPS=113.161.45.12, 14.161.22.88, 172.16.12.*, 127.0.0.1, ::1

# 3. MÃ BÍ MẬT QUẢN TRỊ VIÊN DỰ PHÒNG (ADMIN BYPASS KEY)
# Dùng để Trưởng khoa / Quản trị viên truy cập từ xa ngoài cơ quan để xem báo cáo,
# hoặc cập nhật lại IP Wi-Fi mới nếu modem nhà mạng reset làm đổi IP động.
ADMIN_BYPASS_KEY=ThienAn2026@BypassLab

# 4. BẢO MẬT PHIÊN ĐĂNG NHẬP (SESSION SECRET)
SECRET_KEY=thien-an-vien-dong-khoa-xet-nghiem-super-secure-key-2429
TOKEN_EXPIRE_HOURS=168

# Môi trường chạy (production / development)
APP_ENV=production
